/*
 * K36 portable gaming console - Android DTB
 * HX8394 MIPI DSI panel, 640x480
 */

/dts-v1/;
#include "rk3326-r36s-android.dtsi"

/* K36 speaker amp enable on gpio3 PA7 */
&rk817_codec {
	spk-ctl-gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
};

/* K36 uses ADC for volume buttons, not GPIO */
&gpio_keys {
	status = "disabled";
};

/ {
	reserved-memory {
		drm_logo: drm-logo@00000000 {
			compatible = "rockchip,drm-logo";
			reg = <0x00 0x00 0x00 0x00>;
		};
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 2>;
		io-channel-names = "buttons";
		poll-interval = <100>;
		keyup-threshold-microvolt = <1800000>;

		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <15000>;
		};

		vol-down-key {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <295000>;
		};
	};
};

/*
 * K36 button GPIOs are on gpio3/gpio2, not gpio1 as on R36S.
 * Pinctrl: update btn_pins to K36's actual button pins.
 */
&btn_pins {
	rockchip,pins =
		<3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>,
		<3 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
		<2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>;
		/* gpio2 PB6 (pin14) omitted: conflicts with uart2-m1 RX */
};

/* K36 analog mux is on gpio2, different select pins and channel order */
&joypad {
	amux-a-gpios = <&gpio2 RK_PC0 GPIO_ACTIVE_LOW>;
	amux-b-gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_LOW>;
	/* amux-en on gpio2 PB4 conflicts with uart2-m1 TX — omit, mux always enabled */

	sw1 {
		gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_LOW>;
		label = "GPIO DPAD-UP";
		linux,code = <103>;
	};
	sw2 {
		gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
		label = "GPIO DPAD-DOWN";
		linux,code = <108>;
	};
	sw3 {
		gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_LOW>;
		label = "GPIO DPAD-LEFT";
		linux,code = <105>;
	};
	sw4 {
		gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
		label = "GPIO DPAD-RIGHT";
		linux,code = <106>;
	};
	sw5 {
		gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN-A";
		linux,code = <304>;
	};
	sw6 {
		gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN-B";
		linux,code = <305>;
	};
	sw7 {
		gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN-Y";
		linux,code = <308>;
	};
	sw8 {
		gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN-X";
		linux,code = <307>;
	};
	sw11 {
		/* gpio2 PB6 conflicts with uart2-m1 RX — disabled */
		gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_THUMBR";
		linux,code = <0x2c3>;
	};
	sw12 {
		gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_THUMBL";
		linux,code = <0x2c2>;
	};
	sw13 {
		gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_F";
		linux,code = <172>;
	};
	sw15 {
		gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_TL";
		linux,code = <310>;
	};
	sw16 {
		gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_TR";
		linux,code = <311>;
	};
	sw19 {
		gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_SELECT";
		linux,code = <0x2c0>;
	};
	sw20 {
		gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_TR2";
		linux,code = <313>;
	};
	sw21 {
		gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_TL2";
		linux,code = <312>;
	};
	sw22 {
		gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_LOW>;
		label = "GPIO BTN_START";
		linux,code = <0x2c1>;
	};
};

&display_subsystem {
	logo-memory-region = <&drm_logo>;
};

&route_dsi {
	logo,uboot = "logo.bmp";
	logo,kernel = "logo_kernel.bmp";
	logo,mode = "center";
	charge_logo,mode = "center";
	status = "okay";
};

&dsi {
	panel@0 {
		compatible = "simple-panel-dsi";
		reg = <0>;

		backlight = <&backlight>;
		power-supply = <&vcc_lcd>;

		/* K36: GPIO3_B7 reset (active low) */
		reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
		/* K36: GPIO0_B5 enable (active high) */
		enable-gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;

		prepare-delay-ms = <20>;
		reset-delay-ms = <20>;
		init-delay-ms = <20>;
		enable-delay-ms = <120>;
		disable-delay-ms = <20>;
		unprepare-delay-ms = <20>;

		width-mm = <153>;
		height-mm = <85>;

		dsi,flags = <(MIPI_DSI_MODE_VIDEO           |
			      MIPI_DSI_MODE_VIDEO_BURST     |
			      MIPI_DSI_MODE_LPM             |
			      MIPI_DSI_MODE_EOT_PACKET)>;

		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes = <4>;

		panel-init-sequence = [
			39 00 04 b9 f1 12 83
			39 00 06 b1 00 00 00 da 80
			39 00 04 b2 00 13 70
			39 00 0b b3 10 10 28 28 03 ff 00 00 00 00
			15 00 02 b4 80
			15 00 03 b5 0a 0a
			15 00 03 b6 82 82
			39 00 05 b8 26 62 f0 63
			39 00 1c ba 33 81 05 f9 0e 0e 20 00 00 00 00 00 00 00 44 25 00 90 0a 00 00 01 4f 01 00 00 37
			15 00 02 bc 47
			39 00 04 bf 02 11 00
			39 00 0a c0 73 73 50 50 00 00 12 50 00
			39 00 0d c1 53 00 32 32 77 d1 cc cc 77 77 33 33
			39 00 07 c6 82 00 bf ff 00 ff
			39 00 07 c7 b8 00 0a 00 00 00
			39 00 05 c8 10 40 1e 02
			15 00 02 cc 0b
			39 00 23 e0 00 07 0d 37 35 3f 41 44 06 0c 0d 0f 11 10 12 14 1a 00 07 0d 37 35 3f 41 44 06 0c 0d 0f 11 10 12 14 1a
			39 00 0f e3 07 07 0b 0b 0b 0b 00 00 00 00 ff 00 c0 10
			39 00 40 e9 c8 10 02 00 00 b0 b1 11 31 23 28 80 b0 b1 27 08 00 04 02 00 00 00 00 04 02 00 00 00 88 88 ba 60 24 08 88 88 88 88 88 88 88 ba 71 35 18 88 88 88 88 88 00 00 00 01 00 00 00 00 00 00 00 00 00
			39 00 3e ea 97 0a 82 02 03 07 00 00 00 00 00 00 81 88 ba 17 53 88 88 88 88 88 88 80 88 ba 06 42 88 88 88 88 88 88 23 00 00 02 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			39 00 04 ef ff ff 01
			05 c8 01 11
			05 14 01 29
		];

		panel-exit-sequence = [
			05 00 01 28
			05 00 01 10
		];

		display-timings {
			native-mode = <&timing0>;

			timing0 {
				clock-frequency = <30000000>;
				hactive = <640>;
				vactive = <480>;
				hfront-porch = <150>;
				hsync-len = <50>;
				hback-porch = <150>;
				vfront-porch = <20>;
				vsync-len = <6>;
				vback-porch = <12>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};

			timing1 {
				clock-frequency = <25500000>;
				hactive = <640>;
				vactive = <480>;
				hfront-porch = <135>;
				hsync-len = <40>;
				hback-porch = <135>;
				vfront-porch = <20>;
				vsync-len = <6>;
				vback-porch = <12>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};
	};
};
